{
  "name": "@bank/server",
  "version": "0.0.0",
  "private": true,
  "description": "The Express API that implements api/openapi.yaml.",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "test": "jest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@jest/globals": "^30.5.2",
    "@swc/core": "^1.16.22",
    "@swc/jest": "^0.2.39",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/supertest": "^7.2.1",
    "jest": "^30.5.2",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15"
  },
  "dependencies": {
    "express": "^5.3.0",
    "express-openapi-validator": "^5.6.2",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/test"
    ],
    "transform": {
      "^.+\\.ts$": [
        "@swc/jest",
        {
          "jsc": {
            "parser": {
              "syntax": "typescript"
            }
          }
        }
      ]
    },
    "setupFilesAfterEnv": [
      "<rootDir>/test/support/setup.ts"
    ]
  }
}
