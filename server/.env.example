# Copy to server/.env for local development; `npm run dev -w server` loads it.
# Never commit .env. Every variable the server reads is listed here.

# Port to listen on.
PORT=3000

# development | test | production
NODE_ENV=development

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# The front end's origin, the only one a browser may call the API from: http(s)://host[:port],
# no path or trailing slash. Blank means http://localhost:5173 (the Vite dev server); required
# in production.
CORS_ORIGIN=http://localhost:5173

# How many proxies sit between the internet and this server, as a whole number (0 or more).
# Blank means none: X-Forwarded-For is ignored and the client address is the socket's. Set the
# real number behind a hosting proxy (usually 1), or every client shares one rate-limit counter.
TRUST_PROXY=

# How passcodes are sent. Only `outbox` exists for now: it keeps them in memory (and serves them
# on GET /__test/outbox), and the server refuses to start with it when NODE_ENV is production.
# Blank means outbox.
MAILER=outbox

# Two secrets, each at least 32 bytes; required in every environment, so the server won't start
# until both are set. Generate a separate one for each variable and for each environment, and
# never commit one:
#   node -p "require('node:crypto').randomBytes(32).toString('base64')"
# Signs the access tokens.
JWT_SECRET=
# Keys the hashes of the emailed passcodes.
PASSCODE_SECRET=
